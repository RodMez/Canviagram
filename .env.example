# Base de datos
DATABASE_URL=canviagram.db

# IA — genérico OpenAI-compatible (recomendado OpenRouter para pruebas free)
# Obtener en https://openrouter.ai/keys — compatible con cualquier proveedor
AI_API_KEY=sk-or-REEMPLAZAR
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-3.5-sonnet
# Compat fallback: si solo tienes ANTHROPIC_API_KEY, será usado automáticamente si AI_API_KEY está vacío

# Telegram — obtener de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=REEMPLAZAR
TELEGRAM_WEBHOOK_SECRET=REEMPLAZAR

# Auth — string aleatorio largo, mínimo 32 caracteres (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
SESSION_SECRET=REEMPLAZAR_GENERAR_CON_crypto_randomBytes_48
